{
  "name": "cloudnav",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "A modern cloud-based navigation page built on EdgeOne Pages",
  "keywords": [
    "navigation",
    "bookmarks",
    "edgeone",
    "vue",
    "typescript",
    "vite"
  ],
  "author": "落花流水",
  "license": "GLWTPL",
  "homepage": "https://github.com/niulu114514-pixel/favorite",
  "repository": {
    "type": "git",
    "url": "https://github.com/niulu114514-pixel/favorite.git"
  },
  "bugs": {
    "url": "https://github.com/niulu114514-pixel/favorite/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "lint": "eslint src --ext ts,vue --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css,md,json}\" \"functions/api/*.js\" \"tests/*.js\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css,md,json}\" \"functions/api/*.js\" \"tests/*.js\" \"*.{json,md,ts}\"",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.8",
    "lucide-vue-next": "^0.554.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.0"
  }
}
